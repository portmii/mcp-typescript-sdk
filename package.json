{
	"name": "@portmii/mcp",
	"version": "0.1.0",
	"description": "Protect and meter tool executions with Portmii",
	"license": "Apache-2.0",
	"type": "module",
	"sideEffects": false,
	"engines": {
		"node": "^20.19.0 || >=22.12.0"
	},
	"packageManager": "npm@11.9.0",
	"files": [
		"dist",
		"README.md",
		"LICENSE",
		"NOTICE"
	],
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			},
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
		"build": "tsup",
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:package": "node scripts/package-smoke.mjs",
		"example:server": "npm run build && tsx examples/official-mcp-server/main.ts",
		"validate:package": "publint && attw --pack . --profile node16 && npm run test:package",
		"ci": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run build && npm run validate:package",
		"prepack": "npm run clean && npm run build"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/portmii/mcp-typescript-sdk.git"
	},
	"bugs": {
		"url": "https://github.com/portmii/mcp-typescript-sdk/issues"
	},
	"homepage": "https://github.com/portmii/mcp-typescript-sdk#readme",
	"dependencies": {
		"jose": "^6.2.8"
	},
	"overrides": {
		"esbuild": "0.27.2"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@modelcontextprotocol/node": "^2.1.1",
		"@modelcontextprotocol/sdk": "^1.32.0",
		"@modelcontextprotocol/server": "^2.0.0",
		"@types/express": "^5.0.6",
		"@types/node": "^26.2.0",
		"@vitest/coverage-v8": "^4.1.11",
		"eslint": "^9.39.5",
		"express": "^5.3.0",
		"prettier": "^3.9.6",
		"publint": "^0.3.23",
		"tsup": "^8.5.1",
		"tsx": "^4.23.15",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.66.0",
		"vitest": "^4.1.11",
		"zod": "^4.4.3"
	}
}
